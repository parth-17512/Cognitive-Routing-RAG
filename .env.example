# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your real values.
#                  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (pick ONE) ──────────────────────────────────────────────────

# Option 1: Groq  (recommended — free tier, very fast)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI  (optional fallback)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Ollama  (fully local — no key required)
# Install from: https://ollama.com/  then run: ollama pull llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Model Name ───────────────────────────────────────────────────────────
# For Groq:   llama-3.1-8b-instant  |  llama-3.3-70b-versatile  |  llama-3.1-70b-versatile
# For OpenAI: gpt-4o-mini           |  gpt-3.5-turbo
# For Ollama: llama3
LLM_MODEL=llama-3.1-8b-instant

# ── Embedding Provider ────────────────────────────────────────────────────────
# "local"  → sentence-transformers (no key, runs on CPU, recommended for dev)
# "openai" → OpenAI text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# ── Similarity Threshold ─────────────────────────────────────────────────────
# Cosine similarity threshold for Phase 1 persona routing (0.0 – 1.0)
# Local MiniLM embeddings:  use 0.15 – 0.25  (similarities are naturally lower)
# OpenAI embeddings:        use 0.75 – 0.85  (similarities are compressed near 1.0)
SIMILARITY_THRESHOLD=0.20
